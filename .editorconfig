root = true

[*]
indent_style = space
indent_size = 4
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.ts]
indent_style = space
indent_size = 4
tab_width = 4
quote_type = double

[*.vue]
indent_style = space
indent_size = 4
tab_width = 4
quote_type = double
semi = true

[*.js]
indent_style = space
indent_size = 4
tab_width = 4
semi = true
single_quote = false

[*.json]
indent_style = space
indent_size = 4

[*.md]
max_line_length = 80
